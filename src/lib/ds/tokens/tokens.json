{
	"$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
	"$description": "Dropout Design System tokens. DTCG 2025.10 is the machine-readable source of truth.",
	"color": {
		"$type": "color",
		"ink": {
			"$type": "color",
			"0": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
			"50": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
			"100": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
			"200": { "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
			"300": { "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] } },
			"400": { "$value": { "colorSpace": "oklch", "components": [0.63, 0, 0] } },
			"500": { "$value": { "colorSpace": "oklch", "components": [0.556, 0, 0] } },
			"600": { "$value": { "colorSpace": "oklch", "components": [0.371, 0, 0] } },
			"700": { "$value": { "colorSpace": "oklch", "components": [0.325, 0, 0] } },
			"750": { "$value": { "colorSpace": "oklch", "components": [0.275, 0, 0] } },
			"800": { "$value": { "colorSpace": "oklch", "components": [0.269, 0, 0] } },
			"850": { "$value": { "colorSpace": "oklch", "components": [0.237, 0, 0] } },
			"900": { "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
			"950": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },
			"1000": { "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } }
		},
		"danger": {
			"$value": { "colorSpace": "oklch", "components": [0.577, 0.245, 27.325] }
		},
		"dangerDark": {
			"$value": { "colorSpace": "oklch", "components": [0.704, 0.191, 22.216] }
		},
		"statusConnected": {
			"$value": { "colorSpace": "oklch", "components": [0.696, 0.149, 162.5] }
		}
	},
	"typeScale": {
		"$type": "string",
		"micro": { "$value": "0.625rem" },
		"caption": { "$value": "0.75rem" },
		"label": { "$value": "0.875rem" },
		"body": { "$value": "1rem" },
		"bodyLg": { "$value": "1.0625rem" },
		"button": { "$value": "0.875rem" },
		"lead": { "$value": "1.125rem" },
		"subtitle": { "$value": "clamp(1.25rem, 1.106rem + 0.616vw, 1.5rem)" },
		"titleSm": { "$value": "clamp(1.375rem, 1.086rem + 1.233vw, 1.875rem)" },
		"title": { "$value": "clamp(1.75rem, 1.461rem + 1.233vw, 2.25rem)" },
		"titleLg": { "$value": "clamp(2rem, 1.422rem + 2.465vw, 3rem)" },
		"display": { "$value": "clamp(2.5rem, 1.778rem + 3.082vw, 3.75rem)" },
		"hero": { "$value": "clamp(3rem, 1.75rem + 5vw, 6rem)" }
	},
	"font": {
		"$type": "fontFamily",
		"sans": {
			"$value": [
				"-apple-system",
				"BlinkMacSystemFont",
				"Google Sans Flex",
				"system-ui",
				"Segoe UI",
				"Roboto",
				"Helvetica",
				"Arial",
				"sans-serif"
			]
		}
	},
	"leading": {
		"$type": "number",
		"tightCustom": { "$value": 1.2 },
		"heading": { "$value": 1.25 },
		"body": { "$value": 1.625 }
	},
	"radius": {
		"$type": "dimension",
		"base": { "$value": { "value": 1, "unit": "rem" } },
		"control": { "$value": { "value": 0.6875, "unit": "rem" } },
		"choice": { "$value": { "value": 0.5625, "unit": "rem" } }
	},
	"space": {
		"$type": "dimension",
		"fieldX": { "$value": { "value": 0.9375, "unit": "rem" } },
		"fieldY": { "$value": { "value": 0.8125, "unit": "rem" } },
		"section": { "$value": "clamp(4rem, 8vw, 8rem)" },
		"contentPad": { "$value": "clamp(1rem, 4vw, 2rem)" },
		"shellPad": { "$value": "clamp(18px, 6vw, 120px)" },
		"glassBlur": { "$value": { "value": 40, "unit": "px" } },
		"glassBlurSoft": { "$value": { "value": 4, "unit": "px" } }
	},
	"control": {
		"$type": "dimension",
		"sm": { "$value": { "value": 2.5, "unit": "rem" } },
		"md": { "$value": { "value": 2.75, "unit": "rem" } },
		"lg": { "$value": { "value": 3, "unit": "rem" } }
	},
	"layout": {
		"$type": "dimension",
		"maxWidth": { "$value": { "value": 1560, "unit": "px" } },
		"contentMax": { "$value": { "value": 1280, "unit": "px" } },
		"settingsMax": { "$value": { "value": 960, "unit": "px" } },
		"navHeight": { "$value": { "value": 74, "unit": "px" } },
		"dialogMax": { "$value": { "value": 512, "unit": "px" } },
		"tableMin": { "$value": { "value": 672, "unit": "px" } }
	},
	"motion": {
		"$type": "duration",
		"fast": { "$value": { "value": 150, "unit": "ms" } },
		"base": { "$value": { "value": 250, "unit": "ms" } },
		"slow": { "$value": { "value": 350, "unit": "ms" } },
		"editorial": { "$value": { "value": 450, "unit": "ms" } },
		"ctaPulse": { "$value": { "value": 2800, "unit": "ms" } },
		"statusPulse": { "$value": { "value": 2500, "unit": "ms" } },
		"ease": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
		"easeStandard": { "$type": "cubicBezier", "$value": [0.25, 0.46, 0.45, 0.94] },
		"easeEmphasized": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
		"easeDecelerate": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
	},
	"elevation": {
		"$type": "shadow",
		"float": {
			"$value": [
				{
					"color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.65 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": 12, "unit": "px" },
					"blur": { "value": 32, "unit": "px" },
					"spread": { "value": -12, "unit": "px" }
				},
				{
					"color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.5 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": 4, "unit": "px" },
					"blur": { "value": 12, "unit": "px" },
					"spread": { "value": -6, "unit": "px" }
				}
			]
		},
		"modal": {
			"$value": [
				{
					"color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.75 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": 28, "unit": "px" },
					"blur": { "value": 70, "unit": "px" },
					"spread": { "value": -16, "unit": "px" }
				}
			]
		}
	},
	"semantic": {
		"$description": "Theme roles. Components consume these aliases rather than raw primitives.",
		"light": {
			"background": { "$value": "{color.ink.0}" },
			"foreground": { "$value": "{color.ink.950}" },
			"card": { "$value": "{color.ink.0}" },
			"cardForeground": { "$value": "{color.ink.950}" },
			"primary": { "$value": "{color.ink.900}" },
			"primaryForeground": { "$value": "{color.ink.50}" },
			"secondary": { "$value": "{color.ink.100}" },
			"secondaryForeground": { "$value": "{color.ink.900}" },
			"muted": { "$value": "{color.ink.100}" },
			"mutedForeground": { "$value": "{color.ink.500}" },
			"accent": { "$value": "{color.ink.100}" },
			"accentForeground": { "$value": "{color.ink.900}" },
			"popover": { "$value": "{color.ink.50}" },
			"popoverForeground": { "$value": "{color.ink.950}" },
			"destructive": { "$value": "{color.danger}" },
			"destructiveForeground": { "$value": "{color.ink.0}" },
			"border": { "$value": "{color.ink.200}" },
			"input": { "$value": "{color.ink.200}" },
			"ring": { "$value": "{color.ink.300}" },
			"signal": { "$value": "{color.ink.1000}" },
			"inkMuted": { "$value": "{color.ink.500}" },
			"ink2": { "$value": "{color.ink.100}" },
			"statusConnected": { "$value": "{color.statusConnected}" },
			"hair": { "$value": "{color.ink.1000} / 0.1" },
			"hairSoft": { "$value": "{color.ink.1000} / 0.06" },
			"scrim": { "$value": "{color.ink.1000} / 0.5" },
			"scrimSoft": { "$value": "{color.ink.1000} / 0.1" },
			"glass": { "$value": "{color.ink.0} / 0.72" },
			"glassBorder": { "$value": "{color.ink.1000} / 0.08" },
			"surface1": { "$value": "{color.ink.50}" },
			"surfaceHover": { "$value": "{color.ink.100}" },
			"surface2": { "$value": "{color.ink.200}" },
			"surfaceInput": { "$value": "{color.ink.50}" },
			"elevFloat": { "$value": "{elevation.float}" },
			"elevModal": { "$value": "{elevation.modal}" }
		},
		"dark": {
			"background": { "$value": "{color.ink.950}" },
			"foreground": { "$value": "{color.ink.50}" },
			"card": { "$value": "{color.ink.900}" },
			"cardForeground": { "$value": "{color.ink.50}" },
			"primary": { "$value": "{color.ink.200}" },
			"primaryForeground": { "$value": "{color.ink.900}" },
			"secondary": { "$value": "{color.ink.800}" },
			"secondaryForeground": { "$value": "{color.ink.50}" },
			"muted": { "$value": "{color.ink.800}" },
			"mutedForeground": { "$value": "{color.ink.300}" },
			"accent": { "$value": "{color.ink.600}" },
			"accentForeground": { "$value": "{color.ink.50}" },
			"popover": { "$value": "{color.ink.800}" },
			"popoverForeground": { "$value": "{color.ink.50}" },
			"destructive": { "$value": "{color.dangerDark}" },
			"destructiveForeground": { "$value": "{color.ink.950}" },
			"border": { "$value": "{color.ink.750}" },
			"input": { "$value": "{color.ink.700}" },
			"ring": { "$value": "{color.ink.500}" },
			"signal": { "$value": "{color.ink.0}" },
			"inkMuted": { "$value": "{color.ink.400}" },
			"ink2": { "$value": "{color.ink.900}" },
			"statusConnected": { "$value": "{color.statusConnected}" },
			"hair": { "$value": "{color.ink.0} / 0.1" },
			"hairSoft": { "$value": "{color.ink.0} / 0.055" },
			"scrim": { "$value": "{color.ink.1000} / 0.5" },
			"scrimSoft": { "$value": "{color.ink.1000} / 0.1" },
			"glass": { "$value": "{color.ink.0} / 0.1" },
			"glassBorder": { "$value": "{color.ink.0} / 0.2" },
			"surface1": { "$value": "{color.ink.900}" },
			"surfaceHover": { "$value": "{color.ink.850}" },
			"surface2": { "$value": "{color.ink.800}" },
			"surfaceInput": { "$value": "{color.ink.900}" },
			"elevFloat": { "$value": "{elevation.float}" },
			"elevModal": { "$value": "{elevation.modal}" }
		}
	},
	"presentation": {
		"browserThemeColor": { "$value": "#171717" },
		"background": { "$value": "#171717" },
		"foreground": { "$value": "#f7f7f7" },
		"muted": { "$value": "#d4d4d4" },
		"quiet": { "$value": "#a3a3a3" },
		"border": { "$value": "#404040" },
		"signal": { "$value": "#ffffff" },
		"secondarySurface": { "$value": "#2b2b2b" },
		"fontFamily": { "$value": "-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif" }
	}
}
